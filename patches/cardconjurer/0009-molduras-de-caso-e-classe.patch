+	card.artBounds = {x: 0.0753, y: 0.1124, width: 0.4247, height: 0.7253};
+	autoFitArt();
+	card.setSymbolBounds = {x: 0.9227, y: 0.8739, width: 0.12, height: 0.0381, vertical: 'center', horizontal: 'right'};
+	resetSetSymbol();
+	card.watermarkBounds = {x: 0.5214, y: 0.4748, width: 0.38, height: 0.6767};
+	resetWatermark();
+	// A caixa de regras vira a coluna de capitulos do caso: o texto ja escrito
+	// muda de campo, senao loadTextOptions o descarta junto com o campo antigo.
+	var regras = card.text.rules ? card.text.rules.text : '';
+	loadTextOptions({
+		mana: {name: 'Mana Cost', text: '', y: 0.0613, width: 0.9292, height: 71/2100, oneLine: true, size: 71/1638, align: 'right', shadowX: -0.001, shadowY: 0.0029, manaCost: true, manaSpacing: 0},
+		title: {name: 'Title', text: '', x: 0.0854, y: 0.0522, width: 0.8292, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0381},
+		type: {name: 'Type', text: '', x: 0.0854, y: 0.8481, width: 0.8292, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0324},
+		'case': {name: 'Rules Text', text: '', x: 0.5093, y: 356/2814, width: 0.404, height: 1974/2814, size: 0.03445}
+	});
+	// So quando veio da caixa de regras: numa segunda passada o campo antigo
+	// nao existe mais, e sobrescrever apagaria o texto que ja esta no lugar.
+	if (regras) {
+		card.text['case'].text = regras.replace(/(\r\n|\r|\n)/g, '//{bar}//');
+	}
+
+	var properties = cardFrameProperties(colors, mana_cost, type_line, power);
+	var frames = [];
+	if (properties.pinlineRight) {
+		frames.push(makeCaseFrameByLetter(properties.pinlineRight, 'Pinline', true));
+	}
+	frames.push(makeCaseFrameByLetter(properties.pinline, 'Pinline', false));
+	frames.push(makeCaseFrameByLetter(properties.typeTitle, 'Type', false));
+	frames.push(makeCaseFrameByLetter(properties.typeTitle, 'Title', false));
+	if (properties.rulesRight) {
