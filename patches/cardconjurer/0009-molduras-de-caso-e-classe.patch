+/* script-magic-maker: texto-de-classe-por-nivel */
+// A moldura de classe nao tem caixa de regras: o texto ja formatado se
+// reparte nos campos de nivel, cortado pelas marcas de secao do Scryfall. A
+// linha logo antes de cada marca traz o custo e o nome do nivel que vem.
+function preencherNiveisDeClasse(prefixo, texto) {
+	var abertura = /^((?:{[^}]+})+):\s*(.+)$/;
+	var blocos = [], cabecalhos = [];
+	texto.split(/\n?\/\/[^\/\n]+\/\/\n?/).forEach(function(parte) {
+		var linhas = parte.split('\n').filter(function(linha) { return linha.trim(); });
+		var achado = linhas.length ? linhas[linhas.length - 1].match(abertura) : null;
+		if (achado) { linhas.pop(); cabecalhos.push(achado); }
+		blocos.push(linhas.join('\n'));
+	});
+	card.text.level0c.text = prefixo + blocos[0];
+	for (var i = 1; i < 4; i++) {
+		var cabecalho = cabecalhos[i - 1];
+		card.text['level' + i + 'a'].text = cabecalho ? cabecalho[1] + ':' : '';
+		card.text['level' + i + 'b'].text = cabecalho ? prefixo + cabecalho[2] : '';
+		card.text['level' + i + 'c'].text = cabecalho ? prefixo + (blocos[i] || '') : '';
+	}
+}
 /* script-magic-maker: marcador-de-secao-fora-do-texto */
 // O Scryfall marca em linha propria ("//Level_2//") onde a moldura de classe
-// separa um nivel do outro. Nao e texto da carta: na moldura normal a linha
-// apareceria crua na caixa de regras.
+// separa um nivel do outro. Na moldura de classe a marca diz onde cortar; em
+// qualquer outra ela nao e texto da carta e apareceria crua na caixa.
 function semMarcadorDeSecao(texto) {
 	return typeof texto == 'string' ? texto.replace(/^\/\/[^\/\n]+\/\/\r?\n?/gm, '') : texto;
 }
