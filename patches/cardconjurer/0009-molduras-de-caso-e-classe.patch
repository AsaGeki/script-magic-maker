+	}
+	frames.push(makeCaseFrameByLetter(properties.frame, 'Frame', false));
+	frames.push(makeCaseFrameByLetter(properties.frame, 'Border', false));
+
+	card.frames = frames;
+	card.frames.reverse();
+	await card.frames.forEach(item => addFrame([], item));
+	card.frames.reverse();
+}
