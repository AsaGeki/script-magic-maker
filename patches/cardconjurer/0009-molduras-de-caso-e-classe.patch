+/* script-magic-maker: moldura-de-caso */
+// packCase.js so e alcancavel pelo seletor manual de pacote. As bounds e os
+// campos de texto aqui sao os dele; o que se acrescenta e montar a pilha de
+// molduras a partir das cores, como as outras auto*Frame fazem.
+function makeCaseFrameByLetter(letter, mask, maskToRightHalf) {
+	var frameNames = {'W': 'White', 'U': 'Blue', 'B': 'Black', 'R': 'Red', 'G': 'Green', 'M': 'Multicolored', 'A': 'Artifact', 'L': 'Land'};
+	var maskFiles = {
+		'Pinline': '/img/frames/class/pinline.svg',
+		'Title': '/img/frames/m15/regular/m15MaskTitle.png',
+		'Type': '/img/frames/saga/sagaMaskType.png',
+		'Frame': '/img/frames/class/frame.svg',
+		'Text': '/img/frames/class/text.svg',
+		'Text, Right Half': '/img/frames/class/textRight.png',
+		'Border': '/img/frames/class/border.svg'
+	};
+	letter = letter.toUpperCase();
+	// So a caixa de texto tem mascara propria pra metade direita; o resto usa a
+	// generica por cima.
+	var nome = maskToRightHalf && mask == 'Text' ? 'Text, Right Half' : mask;
+	var frame = {
+		name: frameNames[letter] + ' Frame',
+		src: '/img/frames/class/' + letter.toLowerCase() + '.png',
+		masks: [{src: maskFiles[nome], name: nome}]
+	};
+	if (maskToRightHalf && nome == mask) {
+		frame.masks.push({src: '/img/frames/maskRightHalf.png', name: 'Right Half'});
+	}
+	return frame;
+}
