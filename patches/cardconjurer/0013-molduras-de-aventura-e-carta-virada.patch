+/* script-magic-maker: moldura-de-carta-virada */
+// packFlip.js so e alcancavel pelo seletor manual de pacote. A carta tem duas
+// metades: a de cima normal e a de baixo girada 180 graus, cada uma com nome,
+// tipo, regras e poder/resistencia proprios.
+function makeFlipFrameByLetter(letter, mask) {
+	var frameNames = {'W': 'White', 'U': 'Blue', 'B': 'Black', 'R': 'Red', 'G': 'Green', 'M': 'Multicolored', 'A': 'Artifact', 'L': 'Land', 'C': 'Colorless', 'V': 'Vehicle'};
+	var maskFiles = {
+		'Pinline': '/img/frames/m15/flip/pinline.svg',
+		'Twins': '/img/frames/m15/flip/twins.svg',
+		'Rules': '/img/frames/m15/flip/rules.svg'
+	};
+	letter = letter.toUpperCase();
+	return {
+		name: frameNames[letter] + ' Frame',
+		src: '/img/frames/m15/flip/' + letter.toLowerCase() + '.png',
+		masks: mask ? [{src: maskFiles[mask], name: mask}] : []
+	};
+}
+function makeFlipPTByLetter(letter, embaixo) {
+	var frameNames = {'W': 'White', 'U': 'Blue', 'B': 'Black', 'R': 'Red', 'G': 'Green', 'M': 'Multicolored', 'A': 'Artifact', 'L': 'Land', 'C': 'Colorless', 'V': 'Vehicle'};
+	letter = letter.toUpperCase();
+	return {
+		name: frameNames[letter] + ' Power/Toughness',
+		src: '/img/frames/m15/flip/' + letter.toLowerCase() + 'pt.png',
+		bounds: {x: 0.0374, y: 0.2277, width: 0.9067, height: 0.4762},
+		masks: [{
+			src: embaixo ? '/img/frames/bottomHalfSharp.svg' : '/img/frames/topHalfSharp.svg',
+			name: embaixo ? 'Bottom PT' : 'Top PT'
+		}]
+	};
+}
+async function autoFlipFrame(colors, mana_cost, type_line, power) {
+	card.frames = [];
+	document.querySelector('#frame-list').innerHTML = null;
+
+	await resetCardIrregularities({resetOthers: false});
+	card.version = 'flip';
+	card.artBounds = {x: 0.0754, y: 0.2962, width: 0.8494, height: 0.3315};
+	autoFitArt();
+	card.setSymbolBounds = {x: 0.784, y: 0.26, width: 0.12, height: 0.0410, vertical: 'center', horizontal: 'right'};
+	resetSetSymbol();
+	card.watermarkBounds = {x: 0.5, y: 0.7762, width: 0.75, height: 0.2305};
+	resetWatermark();
+	loadTextOptions({
+		mana: {name: 'Mana Cost', text: '', y: 0.0477, width: 0.9292, height: 71/2100, oneLine: true, size: 71/1638, align: 'right', shadowX: -0.001, shadowY: 0.0029, manaCost: true, manaSpacing: 0},
+		title: {name: 'Title 1', text: '', x: 0.0854, y: 0.0386, width: 0.8292, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0381},
+		type: {name: 'Type 1', text: '', x: 0.0854, y: 0.2353, width: 0.8292, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0324},
+		rules: {name: 'Rules Text 1', text: '', x: 0.086, y: 0.102, width: 0.828, height: 0.12, size: 0.0362},
+		pt: {name: 'Power/Toughness 1', text: '', x: 0.8267, y: 0.2448, width: 0.0967, height: 0.0372, size: 0.0372, font: 'belerenbsc', oneLine: true, align: 'center'},
+		title2: {name: 'Title 2', text: '', x: 0.9147, y: 0.8848, width: 0.8292, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0381, rotation: 180},
+		type2: {name: 'Type 2', text: '', x: 0.9147, y: 0.6886, width: 0.8292, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0324, rotation: 180},
+		rules2: {name: 'Rules Text 2', text: '', x: 0.914, y: 0.821, width: 0.828, height: 0.12, size: 0.0362, rotation: 180},
+		pt2: {name: 'Power/Toughness 2', text: '', x: 0.1734, y: 0.6791, width: 0.0967, height: 0.0372, size: 0.0372, font: 'belerenbsc', oneLine: true, align: 'center', rotation: 180}
+	});
+
+	var properties = cardFrameProperties(colors, mana_cost, type_line, power);
+	var frames = [];
+	if (properties.pt) {
+		frames.push(makeFlipPTByLetter(properties.pt, false));
+		frames.push(makeFlipPTByLetter(properties.pt, true));
+	}
+	frames.push(makeFlipFrameByLetter(properties.pinline, 'Pinline'));
+	frames.push(makeFlipFrameByLetter(properties.typeTitle, 'Twins'));
+	frames.push(makeFlipFrameByLetter(properties.rules, 'Rules'));
+	frames.push(makeFlipFrameByLetter(properties.frame, ''));
+
+	card.frames = frames;
+	card.frames.reverse();
+	await card.frames.forEach(item => addFrame([], item));
+	card.frames.reverse();
+}
+/* script-magic-maker: moldura-de-aventura */
+// packAdventure.js so e alcancavel pelo seletor manual de pacote. A carta tem
+// arte e titulo de cima como qualquer criatura; o que muda e a metade de baixo,
+// repartida entre o livro da aventura (esquerda) e as regras da criatura
+// (direita).
+function makeAdventureFrameByLetter(letter, mask, maskToRightHalf) {
+	var frameNames = {'W': 'White', 'U': 'Blue', 'B': 'Black', 'R': 'Red', 'G': 'Green', 'M': 'Multicolored', 'A': 'Artifact', 'L': 'Land'};
+	var maskFiles = {
+		'Pinline': '/img/frames/adventure/regular/pinline.svg',
+		'Title': '/img/frames/m15/regular/m15MaskTitle.png',
+		'Type': '/img/frames/m15/regular/m15MaskType.png',
+		'Rules': '/img/frames/adventure/regular/book.svg',
+		'Rules (Left)': '/img/frames/adventure/regular/bookLeft.png',
+		'Rules (Right)': '/img/frames/adventure/regular/bookRight.png'
+	};
+	letter = letter.toUpperCase();
+	var frame = {
+		name: frameNames[letter] + ' Frame',
+		src: '/img/frames/adventure/regular/' + letter.toLowerCase() + '.png',
+		masks: mask ? [{src: maskFiles[mask], name: mask}] : []
+	};
+	if (maskToRightHalf && mask && !mask.includes('(')) {
+		frame.masks.push({src: '/img/frames/maskRightHalf.png', name: 'Right Half'});
+	}
+	return frame;
+}
+async function autoAdventureFrame(colors, mana_cost, type_line, power) {
+	card.frames = [];
+	document.querySelector('#frame-list').innerHTML = null;
+
+	await resetCardIrregularities({resetOthers: false});
+	card.version = 'adventure';
+	card.artBounds = {x: 0.0767, y: 0.1129, width: 0.8476, height: 0.4429};
+	autoFitArt();
+	card.setSymbolBounds = {x: 0.9213, y: 0.5910, width: 0.12, height: 0.0410, vertical: 'center', horizontal: 'right'};
+	resetSetSymbol();
+	card.watermarkBounds = {x: 0.72, y: 0.7681, width: 0.3867, height: 0.2358};
+	resetWatermark();
+	loadTextOptions({
+		mana: {name: 'Mana Cost', text: '', y: 0.0613, width: 0.9292, height: 71/2100, oneLine: true, size: 71/1638, align: 'right', shadowX: -0.001, shadowY: 0.0029, manaCost: true, manaSpacing: 0},
+		title: {name: 'Title', text: '', x: 0.0854, y: 0.0522, width: 0.8292, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0381},
+		type: {name: 'Type', text: '', x: 0.0854, y: 0.5664, width: 0.8292, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0324},
+		rules: {name: 'Rules Text', text: '', x: 0.0854, y: 0.7358, width: 0.3947, height: 0.15, size: 0.0353},
+		rules2: {name: 'Rules Text (Right)', text: '', x: 0.5267, y: 0.65, width: 0.3867, height: 0.2358, size: 0.0353},
+		pt: {name: 'Power/Toughness', text: '', x: 0.7928, y: 0.902, width: 0.1367, height: 0.0372, size: 0.0372, font: 'belerenbsc', oneLine: true, align: 'center'},
+		mana2: {name: 'Adventure Mana Cost', text: '', x: 0.0814, y: 0.6391, width: 0.4, height: 60/2100, oneLine: true, size: 60/1638, color: 'white', shadowX: -0.001, shadowY: 0.0029, align: 'right', manaCost: true},
+		title2: {name: 'Adventure Title', text: '', x: 0.0814, y: 0.6391, width: 0.4, height: 0.0296, size: 0.0296, color: 'white', oneLine: true, font: 'belerenb'},
+		type2: {name: 'Adventure Type', text: '', x: 0.0814, y: 0.6839, width: 0.4, height: 0.0296, size: 0.0296, color: 'white', oneLine: true, font: 'belerenb'}
+	});
+
+	var properties = cardFrameProperties(colors, mana_cost, type_line, power);
+	var frames = [];
+	if (type_line.includes('Legendary')) {
+		frames.push(makeM15FrameByLetter(properties.pinline, 'Crown', false));
+		frames.push(makeM15FrameByLetter(properties.pinline, 'Crown Border Cover', false));
+	}
+	if (properties.pt) {
+		frames.push(makeM15FrameByLetter(properties.pt, 'PT', false));
+	}
+	if (properties.pinlineRight) {
+		frames.push(makeAdventureFrameByLetter(properties.pinlineRight, 'Pinline', true));
+	}
+	frames.push(makeAdventureFrameByLetter(properties.pinline, 'Pinline', false));
+	frames.push(makeAdventureFrameByLetter(properties.typeTitle, 'Type', false));
+	frames.push(makeAdventureFrameByLetter(properties.typeTitle, 'Title', false));
+	// O livro da aventura tem metade esquerda e direita proprias; em carta de uma
+	// cor so as duas saem da mesma letra.
+	frames.push(makeAdventureFrameByLetter(properties.rulesRight || properties.rules, 'Rules (Right)', false));
+	frames.push(makeAdventureFrameByLetter(properties.rules, 'Rules (Left)', false));
+	if (properties.frameRight) {
+		frames.push(makeAdventureFrameByLetter(properties.frameRight, '', true));
+	}
+	frames.push(makeAdventureFrameByLetter(properties.frame, '', false));
+
+	card.frames = frames;
+	card.frames.reverse();
+	await card.frames.forEach(item => addFrame([], item));
+	card.frames.reverse();
+}
 /* script-magic-maker: moldura-de-vanguarda */
