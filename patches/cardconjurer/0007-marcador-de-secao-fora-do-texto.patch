+/* script-magic-maker: marcador-de-secao-fora-do-texto */
+// O Scryfall marca em linha propria ("//Level_2//") onde a moldura de classe
+// separa um nivel do outro. Nao e texto da carta: na moldura normal a linha
+// apareceria crua na caixa de regras.
+function semMarcadorDeSecao(texto) {
+	return typeof texto == 'string' ? texto.replace(/^\/\/[^\/\n]+\/\/\r?\n?/gm, '') : texto;
+}
