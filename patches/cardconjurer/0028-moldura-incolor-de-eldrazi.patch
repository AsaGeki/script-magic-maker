+/* script-magic-maker: moldura-incolor-fora-da-borderless */
+// Troca pela letra 'C', a moldura cinza de Eldrazi, o que o
+// cardFrameProperties() manda pra 'A' e 'L' na carta incolor. So chama quem
+// tem arquivo incolor no pacote; ficha, saga e modal nao tem.
+function comMolduraIncolor(properties, colors, typeLine) {
+	if (colors.length != 0 || typeLine.includes('Artifact') || typeLine.includes('Land') || typeLine.includes('Vehicle')) {
+		return properties;
+	}
+	['pinline', 'rules', 'typeTitle', 'pt', 'frame'].forEach(function (campo) {
+		if (properties[campo]) {
+			properties[campo] = 'C';
+		}
+	});
+	return properties;
+}
