+/* script-magic-maker: moldura-dividida */
+// packSplit.js so e alcancavel pelo seletor manual de pacote. A carta e lida
+// deitada e tem duas metades completas, cada uma com nome, custo, tipo e
+// regras; o texto sai girado -90 graus.
+//
+// A cor de cada metade sai do custo dela, nao do custo somado:
+// card.custosDasMetades traz os dois, emprestados por aplicar-moldura.js.
+function makeSplitFrameByLetter(letter, metade, soADireita) {
+	var frameNames = {'W': 'White', 'U': 'Blue', 'B': 'Black', 'R': 'Red', 'G': 'Green', 'M': 'Multicolored', 'A': 'Artifact', 'L': 'Land'};
+	letter = letter.toUpperCase();
+	var masks = [{src: '/img/frames/m15/split/' + metade + '.svg', name: metade == 'top' ? 'Top Half' : 'Bottom Half'}];
+	// Mascara sobre mascara se cruza: com as duas sobra so o quarto da carta.
+	if (soADireita) {
+		masks.push({src: '/img/frames/maskRightHalf.png', name: 'Right Half'});
+	}
+	return {
+		name: frameNames[letter] + ' Frame',
+		src: '/img/frames/m15/split/' + letter.toLowerCase() + '.png',
+		masks: masks
+	};
+}
+// Cada metade tem custo proprio, entao cor propria. Metade hibrida sai em duas
+// cores como o autoM15Frame faz: a segunda so na parte direita.
+//
+// Na carta impressa esse degrade e DIAGONAL - a metade e lida girada, entao a
+// segunda cor cobre o topo e a direita e desbota pra base esquerda. O catalogo
+// nao tem mascara pra isso: as unicas horizontais cortam no meio da carta, que
+// e justamente a divisa entre as duas metades. O corte reto acerta 4 dos 6
+// pontos de borda medidos; o inverso acerta 3.
+function molduraDaMetade(custo, metade, frames) {
+	var cores = [...new Set((custo.toUpperCase().match(/[WUBRG]/g) || []))];
+	if (cores.length == 2 && custo.includes('/')) {
+		frames.push(makeSplitFrameByLetter(cores[1], metade, true));
+		frames.push(makeSplitFrameByLetter(cores[0], metade, false));
+		return;
+	}
+	var letra = cores.length > 1 ? 'M' : (cores.length == 1 ? cores[0] : 'A');
+	frames.push(makeSplitFrameByLetter(letra, metade, false));
+}
+async function autoSplitFrame(colors, mana_cost, type_line, power) {
+	// Lido antes do primeiro await: quem empresta os custos os devolve assim que
+	// autoFrame() retorna, e daqui pra frente eles ja nao estao mais em card.
+	var custos = card.custosDasMetades || [mana_cost, mana_cost];
+	card.frames = [];
+	document.querySelector('#frame-list').innerHTML = null;
+
+	await resetCardIrregularities({resetOthers: false});
+	card.version = 'split';
+	// O pacote so tem uma janela de arte, e a carta impressa tem duas. Cobrir
+	// a carta inteira faz a mesma arte aparecer nas duas, em vez de deixar a
+	// segunda como um buraco preto.
+	card.artBounds = {x: 0, y: 0, width: 1, height: 1};
+	autoFitArt();
+	card.setSymbolBounds = {x: 2, y: 2, width: 0.12, height: 0.0410, vertical: 'center', horizontal: 'right'};
+	resetSetSymbol();
+	card.watermarkBounds = {x: 0.5, y: 0.7762, width: 0.75, height: 0.2305};
+	resetWatermark();
+	loadTextOptions({
+		mana: {name: 'Mana Cost (Right)', text: '', x: 0.0847, y: 0.4381, width: 0.5367, height: 71/2100, oneLine: true, size: 71/1638, align: 'right', shadowX: -0.001, shadowY: 0.0029, manaCost: true, manaSpacing: 0, rotation: -90},
+		title: {name: 'Title (Right)', text: '', x: 0.072, y: 0.4381, width: 0.5367, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0381, rotation: -90},
+		type: {name: 'Type (Right)', text: '', x: 0.55, y: 0.4381, width: 0.5367, height: 0.0286, oneLine: true, font: 'belerenb', size: 0.0286, rotation: -90},
+		rules: {name: 'Rules Text (Right)', text: '', x: 0.6087, y: 0.4334, width: 0.5174, height: 0.2443, size: 0.0362, rotation: -90},
+		mana2: {name: 'Mana Cost (Left)', text: '', x: 0.0847, y: 0.8943, width: 0.5367, height: 71/2100, oneLine: true, size: 71/1638, align: 'right', shadowX: -0.001, shadowY: 0.0029, manaCost: true, manaSpacing: 0, rotation: -90},
+		title2: {name: 'Title (Left)', text: '', x: 0.072, y: 0.8943, width: 0.5367, height: 0.0543, oneLine: true, font: 'belerenb', size: 0.0381, rotation: -90},
+		type2: {name: 'Type (Left)', text: '', x: 0.55, y: 0.8943, width: 0.5367, height: 0.0286, oneLine: true, font: 'belerenb', size: 0.0286, rotation: -90},
+		rules2: {name: 'Rules Text (Left)', text: '', x: 0.6087, y: 0.8896, width: 0.5174, height: 0.2443, size: 0.0362, rotation: -90}
+	});
+
+	var frames = [];
+	molduraDaMetade(custos[0], 'top', frames);
+	molduraDaMetade(custos[1], 'bottom', frames);
+
+	card.frames = frames;
+	card.frames.reverse();
+	await card.frames.forEach(item => addFrame([], item));
+	card.frames.reverse();
+}
 /* script-magic-maker: moldura-de-carta-virada */
