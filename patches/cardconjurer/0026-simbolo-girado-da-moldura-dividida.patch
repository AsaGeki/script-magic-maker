@@ -118,6 +118,10 @@
 //Card Object managament
 async function resetCardIrregularities({canvas = [getStandardWidth(), getStandardHeight(), 0, 0], resetOthers = true} = {}) {
 	//misc details
+	/* script-magic-maker: simbolo-girado-da-moldura-dividida */
+	// So a moldura dividida desenha simbolo deitado; sem apagar aqui, ele
+	// sobreviveria na proxima moldura carregada.
+	card.simbolosGirados = null;
 	card.margins = false;
 	card.bottomInfoTranslate = {x:0, y:0};
 	card.bottomInfoRotate = 0;
@@ -5966,6 +5970,18 @@
 		claroContexto.fillStyle = 'white';
 		claroContexto.fillRect(0, 0, claro.width, claro.height);
 		cardContext.drawImage(claro, scaleX(card.setSymbolX), scaleY(card.setSymbolY), simboloLargura, simboloAltura);
+	} else if (card.simbolosGirados) {
+		/* script-magic-maker: simbolo-girado-da-moldura-dividida */
+		// A carta dividida tem duas faixas de tipo deitadas, e cada uma leva o
+		// seu simbolo. Cada ancora e a ponta direita da faixa (o alto, na carta
+		// em pe) e o meio dela no outro eixo; o simbolo desce a partir dali.
+		card.simbolosGirados.forEach(function(ancora) {
+			cardContext.save();
+			cardContext.translate(scaleX(ancora.x), scaleY(ancora.y));
+			cardContext.rotate(-Math.PI / 2);
+			cardContext.drawImage(setSymbol, -simboloLargura, -simboloAltura / 2, simboloLargura, simboloAltura);
+			cardContext.restore();
+		});
 	} else {
 		cardContext.drawImage(setSymbol, scaleX(card.setSymbolX), scaleY(card.setSymbolY), simboloLargura, simboloAltura);
 	}
