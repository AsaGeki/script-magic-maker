+/* script-magic-maker: moldura-de-saga-de-duas-faces */
+// A saga que transforma reparte a carta como a saga comum - capitulos a
+// esquerda, arte alta a direita - e ainda leva o simbolo da transformada no
+// nome e o poder/resistencia do verso acima da linha de tipo. O pacote SagaDFC
+// tem as duas coisas, e o autoFrame nao chegava nele: a carta caia na
+// M15TransformFront, que poe os capitulos como texto corrido.
+var MASCARAS_DA_SAGA_DFC = {
+	'Pinline': '/img/frames/saga/dfc/pinline.svg',
+	'Title': '/img/frames/m15/transform/regular/maskTitle.png',
+	'Type': '/img/frames/saga/sagaMaskType.png',
+	'Frame': '/img/frames/saga/dfc/frame.svg',
+	'Banner': '/img/frames/saga/dfc/banner.svg',
+	'Banner (Right)': '/img/frames/saga/dfc/bannerRight.svg',
+	'Text': '/img/frames/saga/dfc/rules.svg',
+	'Text (Right)': '/img/frames/saga/sagaMaskTextRight.png',
+	'Border': '/img/frames/saga/sagaMaskBorder.png'
+};
+// O pacote tem colorida, multicolorida e de terreno; nao tem a de artefato que
+// a saga comum tem, entao incolor e artefato caem na multicolorida.
+var CORES_DA_SAGA_DFC = ['W', 'U', 'B', 'R', 'G', 'M', 'L'];
+function makeSagaDFCFrameByLetter(letter, mask, maskToRightHalf) {
+	var frameNames = {'W': 'White', 'U': 'Blue', 'B': 'Black', 'R': 'Red', 'G': 'Green', 'M': 'Multicolored', 'L': 'Land'};
+	letter = letraDaDuplaFace(letter, true);
+	if (!CORES_DA_SAGA_DFC.includes(letter)) {
+		letter = 'M';
+	}
+	var nome = maskToRightHalf && MASCARAS_DA_SAGA_DFC[mask + ' (Right)'] ? mask + ' (Right)' : mask;
+	var frame = {
+		name: frameNames[letter] + ' Frame',
+		src: '/img/frames/saga/dfc/' + letter.toLowerCase() + '.png',
+		masks: [{src: MASCARAS_DA_SAGA_DFC[nome], name: nome}]
+	};
+	if (maskToRightHalf && nome == mask) {
+		frame.masks.push({src: '/img/frames/maskRightHalf.png', name: 'Right Half'});
+	}
+	return frame;
+}
