+/* script-magic-maker: assinatura-do-flavor-em-linha-propria */
+// A carta impressa poe a assinatura do flavor em linha propria, mas o
+// flavor_text do Scryfall nem sempre traz a quebra (M14 #139 nao traz, SNC
+// #18 traz). Sem ela o travessao fica colado no fim da frase anterior.
+function comQuebraNaAssinatura(texto) {
+	if (texto.includes('\n')) {
+		return texto;
+	}
