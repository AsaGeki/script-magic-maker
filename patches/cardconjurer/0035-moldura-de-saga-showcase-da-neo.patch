index 63527b0..01dfb38 100644
--- a/js/creator-23.js
+++ b/js/creator-23.js
@@ -940,6 +940,13 @@ function autoFrame() {
 		// A frente da saga que transforma nao tem poder/resistencia: o do verso
 		// entra depois, no campo backPT do pacote.
 		autoSagaDFCFrame(colors, card.text.mana.text, card.text.type.text, '');
+	/* script-magic-maker: moldura-de-saga-showcase-da-neo */
+	} else if (frame == 'SagaNeo') {
+		group = 'Showcase-5';
+		autoSagaNeoFrame(colors, card.text.mana.text, card.text.type.text, '');
+	} else if (frame == 'SagaNeoBack') {
+		group = 'Showcase-5';
+		autoSagaNeoBackFrame(colors, card.text.mana.text, card.text.type.text, card.text.pt ? card.text.pt.text : '');
 	/* script-magic-maker: moldura-de-caso */
 	} else if (frame == 'Case') {
 		group = 'Saga-1';
@@ -2226,6 +2233,113 @@ async function autoSagaDFCFrame(colors, mana_cost, type_line, power) {
 	await card.frames.forEach(item => addFrame([], item));
 	card.frames.reverse();
 }
+/* script-magic-maker: moldura-de-saga-showcase-da-neo */
+// A saga showcase da NEO (354-362) tem a mesma reparticao da saga de duas faces
+// - capitulos a esquerda, arte alta a direita -, e um aro ornamentado que nao
+// se monta por mascara: o pacote traz uma imagem por cor, ja com o texto, os
+// hexagonos e a arte tirados do scan. Por isso a camada e uma so.
+//
+// O miolo das medidas saiu do proprio scan de 745x1040: a janela de arte fica
+// em x 374-715 e y 118-870, que e o que esta em ARTE_DA_SAGA_NEO.
+var ARTE_DA_SAGA_NEO = {x: 0.5020, y: 0.1135, width: 0.4591, height: 0.7240};
+var CORES_DA_SAGA_NEO = ['W', 'U', 'B', 'R', 'G', 'M'];
+
+function carregarVersaoDaSagaNeo() {
+	card.version = 'sagaNeo';
+	card.onload = '/js/frames/versionSaga.js';
+	// Antes do versionSaga.js: ele so preenche card.saga quando nao ha um, e o
+	// hexagono desta moldura fica mais a esquerda que o disco da saga comum.
+	card.saga = {abilities: [1, 1, 1, 0], count: 3, x: 0.103, width: 0.39};
+	loadScript('/js/frames/versionSaga.js');
+	card.artBounds = Object.assign({}, ARTE_DA_SAGA_NEO);
+	autoFitArt();
+	card.setSymbolBounds = {x: 0.9396, y: 0.8721, width: 0.12, height: 0.0381, vertical: 'center', horizontal: 'right'};
+	resetSetSymbol();
+	card.watermarkBounds = {x: 0.3027, y: 0.4748, width: 0.3547, height: 0.6767};
