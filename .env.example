# Nenhuma variável aqui é obrigatória: todas têm default no app/config.py.

# Porta da API FastAPI de consulta.
PORT=8000

# Onde as imagens geradas são salvas.
OUTPUT_DIR=output

# false abre o navegador na tela, útil pra depurar a automação.
HEADLESS=true

# Onde o fork do Card Conjurer é clonado (ignorado no git, ~2,7 GB).
CARDCONJURER_DIR=vendor/cardconjurer

# Porta do servidor estático local do Card Conjurer.
CARDCONJURER_PORT=4242

# User-Agent enviado ao Scryfall; a API pede um identificável.
SCRYFALL_USER_AGENT=script-magic-maker/0.1.0
